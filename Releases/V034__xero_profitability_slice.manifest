# =====================================================================
# Release V034 -- Xero profitability slice (Demo Company, Tenant_ID 99)
# =====================================================================
# Lands -> Bronze -> Silver -> Gold for Xero P&L data so practice costs/margin can
# sit alongside Dentally revenue. Prereq: run `python API/xero_land.py` first to
# write the OneLake stage_xero_* Delta tables (Stage views read them).
#
#   Stage.Views              -- + Stage.Xero_Accounts / Stage.Xero_Lines
#   Bronze.Xero_Accounts/_Lines + load procs
#   Silver.Xero_Accounts (chart + PL_Group) / Xero_Finance_Lines (reconciled P&L transform)
#   Gold.Dim_GL_Account + Fact_Finance
#
# Then loads tenant 99 through the stack and regenerates the PBI views.
#
# Run: .\Scripts\Deploy.ps1 -Manifest Releases\V034__xero_profitability_slice.manifest
# =====================================================================

DEPLOY   Fabric\Stage.Views.sql

DEPLOY   Fabric\Bronze.Xero_Accounts.Table.sql
DEPLOY   Fabric\Bronze.Xero_Lines.Table.sql
DEPLOY   Fabric\Bronze.usp_Load_Xero_Accounts.StoredProcedure.sql
DEPLOY   Fabric\Bronze.usp_Load_Xero_Lines.StoredProcedure.sql

DEPLOY   Fabric\Silver.Xero_Accounts.Table.sql
DEPLOY   Fabric\Silver.Xero_Finance_Lines.Table.sql
DEPLOY   Fabric\Silver.usp_Load_Xero_Accounts.StoredProcedure.sql
DEPLOY   Fabric\Silver.usp_Load_Xero_Finance_Lines.StoredProcedure.sql

DEPLOY   Fabric\Gold.Dim_GL_Account.Table.sql
DEPLOY   Fabric\Gold.Fact_Finance.Table.sql
DEPLOY   Fabric\Gold.usp_Load_Dim_GL_Account.StoredProcedure.sql
DEPLOY   Fabric\Gold.usp_Load_Fact_Finance.StoredProcedure.sql

EXEC     DECLARE @i BIGINT,@u BIGINT,@d BIGINT; EXEC Bronze.usp_Load_Xero_Accounts @Tenant_ID=99,@Run_Inserts=@i OUT,@Run_Updates=@u OUT,@Run_Deletes=@d OUT;
EXEC     DECLARE @i BIGINT,@u BIGINT,@d BIGINT; EXEC Bronze.usp_Load_Xero_Lines @Tenant_ID=99,@Run_Inserts=@i OUT,@Run_Updates=@u OUT,@Run_Deletes=@d OUT;
EXEC     DECLARE @i BIGINT,@u BIGINT,@d BIGINT; EXEC Silver.usp_Load_Xero_Accounts @Tenant_ID=99,@Run_Inserts=@i OUT,@Run_Updates=@u OUT,@Run_Deletes=@d OUT;
EXEC     DECLARE @i BIGINT,@u BIGINT,@d BIGINT; EXEC Silver.usp_Load_Xero_Finance_Lines @Tenant_ID=99,@Run_Inserts=@i OUT,@Run_Updates=@u OUT,@Run_Deletes=@d OUT;
EXEC     DECLARE @i BIGINT,@u BIGINT,@d BIGINT; EXEC Gold.usp_Load_Dim_GL_Account @Run_Inserts=@i OUT,@Run_Updates=@u OUT,@Run_Deletes=@d OUT;
EXEC     DECLARE @i BIGINT,@u BIGINT,@d BIGINT; EXEC Gold.usp_Load_Fact_Finance @Run_Inserts=@i OUT,@Run_Updates=@u OUT,@Run_Deletes=@d OUT;
EXEC     EXEC Meta.usp_Create_Gold_Views;

TEST
