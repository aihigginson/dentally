# =====================================================================
# Release V182 -- rebuild affiliate commission as Gold, not as ad-hoc views
# =====================================================================
# V181 built this as two hand-written Billing.vw_* views and a guard script. Both were wrong and
# this replaces them. The data is vendor money, which is a reason not to IMPORT it into the
# customer semantic model -- it is not a reason to build it differently from everything else.
#
#   Gold.Dim_Affiliates                 -> PBI.[List Affiliates]
#   Gold.Dim_Affiliate_Payments         -> PBI.[List Affiliate Payments]
#   Gold.Fact_Affiliate_Payment_Lines   -> PBI.[_Affiliate Payment Lines]
#
# The PBI views are GENERATED by Meta.usp_Create_Gold_Views from those names -- nothing here
# writes a PBI view by hand. That is also why V181's guard had to go: it failed on anything
# affiliate-shaped in the PBI schema, so it would have blocked this architecture outright.
#
# Billing.* FEEDING GOLD IS THE NORMAL PATTERN HERE, not an exception: 13 Gold loads already read
# the owner-curated Input schema exactly this way.
#
# Billing.Affiliate_Payout (V181) STAYS -- it is the source table the Admin screen writes to, and
# holds payment history regenerable from nowhere else. Only the two views are dropped.
#
# GRAIN. Fact_Affiliate_Payment_Lines is one row per BILLED USER per practice per month -- the
# invoice line the commission was earned on, so every figure in a statement rolls up from the
# fact rather than being computed beside it. Full rebuild with pk from ROW_NUMBER(), as
# Fact_Patient_At_Risk and Fact_Appointment_Journey already do: it is wholly derived from Billing,
# so there is nothing an incremental load would protect.
#
# CREDITS ARE APPORTIONED PRO RATA across a month's lines, by each line's share of the month's
# value. Credit notes are raised per practice-month and there is no single line to attach one to;
# holding credits at a coarser grain instead would mean the fact does not add up to the statement,
# which is worse than apportioning. Rounding is to the penny per line.
#
# THREE CORRECTNESS POINTS CARRIED OVER FROM V181, each verified against dev data:
#   1. Credit_Note.Amount_Pence is GROSS; Invoice_Line.Value is NET. Clawing commission back on
#      the gross figure takes 20% too much off the affiliate every time. Net = Amount - Tax.
#      (Stripe_Invoice.Amount_Pence is NET, unlike Credit_Note -- the source schema disagrees with
#      itself, which is why Invoice_Line is the invoiced figure and neither of those is.)
#   2. Commission is EARNED on invoicing but PAYABLE on collection: Commission_Payable is 0 until
#      Stripe reports the customer paid.
#   3. The rate comes off the LINE, frozen at generation, so re-rating an affiliate cannot restate
#      a statement already settled.
#
# ==> ONE KNOWN WEAKNESS, SHARED WITH EXISTING CODE. <== usp_Load_Dim_Affiliate_Payments reads
# Gold.Dim_Affiliates to resolve fk_Affiliate, and Generate_Process_Dependencies.ps1 does not model
# Dim -> Dim edges, so nothing enforces that affiliates load first. Both are level-3 GOLD_DIM and
# could run in either order, leaving fk_Affiliate NULL on a first load and self-healing on the
# next. This is EXACTLY the shape of the existing Dim_Patients -> Dim_Acquisition_Sources
# dependency, which is also unregistered -- so this follows the established pattern rather than
# inventing a safer one for a single case. Worth fixing properly in the generator, for both.
#
# Run: .\Scripts\Deploy.ps1 -Manifest Releases\V182__affiliate_gold_medallion.manifest
# =====================================================================

# V181's ad-hoc views, superseded. The Gold objects below replace them.
EXEC     DROP VIEW IF EXISTS [Billing].[vw_Affiliate_Commission];
EXEC     DROP VIEW IF EXISTS [Billing].[vw_Affiliate_Payout];

DEPLOY   Fabric\Gold.Dim_Affiliates.Table.sql
DEPLOY   Fabric\Gold.usp_Load_Dim_Affiliates.StoredProcedure.sql
DEPLOY   Fabric\Gold.Dim_Affiliate_Payments.Table.sql
DEPLOY   Fabric\Gold.usp_Load_Dim_Affiliate_Payments.StoredProcedure.sql
DEPLOY   Fabric\Gold.Fact_Affiliate_Payment_Lines.Table.sql
DEPLOY   Fabric\Gold.usp_Load_Fact_Affiliate_Payment_Lines.StoredProcedure.sql

DEPLOY   Fabric\Audit.Process_Config.Data.sql
DEPLOY   Fabric\Audit.Process_Dependency.Data.sql

# DIM before DIM before FACT, for the reason in the weakness note above.
EXEC     DECLARE @i BIGINT,@u BIGINT,@d BIGINT; EXEC Gold.usp_Load_Dim_Affiliates @Mode='PROD',@Run_Inserts=@i OUT,@Run_Updates=@u OUT,@Run_Deletes=@d OUT;
EXEC     DECLARE @i BIGINT,@u BIGINT,@d BIGINT; EXEC Gold.usp_Load_Dim_Affiliate_Payments @Mode='PROD',@Run_Inserts=@i OUT,@Run_Updates=@u OUT,@Run_Deletes=@d OUT;
EXEC     DECLARE @i BIGINT,@u BIGINT,@d BIGINT; EXEC Gold.usp_Load_Fact_Affiliate_Payment_Lines @Mode='PROD',@Run_Inserts=@i OUT,@Run_Updates=@u OUT,@Run_Deletes=@d OUT;

EXEC     EXEC Meta.usp_Create_Gold_Views;

# The fact must still add up: commission due is the accrued figure plus the credit adjustment, to
# the penny, on every line. A failure means the gross/net trap has come back.
EXEC     DECLARE @bad INT, @msg VARCHAR(4000); SELECT @bad = COUNT(*) FROM [Gold].[Fact_Affiliate_Payment_Lines] WHERE ABS(Commission_Due - (Commission_Accrued + Commission_On_Credits)) > 0.005; IF @bad > 0 BEGIN SET @msg = 'V182 FAILED: ' + CAST(@bad AS VARCHAR(10)) + ' fact row(s) where Commission_Due <> Commission_Accrued + Commission_On_Credits.'; THROW 50182, @msg, 1; END;

# Nothing payable against an uncollected invoice.
EXEC     DECLARE @b2 INT, @m2 VARCHAR(4000); SELECT @b2 = COUNT(*) FROM [Gold].[Fact_Affiliate_Payment_Lines] WHERE Is_Customer_Paid = 0 AND Commission_Payable <> 0; IF @b2 > 0 BEGIN SET @m2 = 'V182 FAILED: ' + CAST(@b2 AS VARCHAR(10)) + ' fact row(s) payable against an uncollected invoice.'; THROW 50192, @m2, 1; END;

# The apportioned credits must sum back to the credit notes actually raised, per practice-month.
EXEC     DECLARE @b3 INT, @m3 VARCHAR(4000); SELECT @b3 = COUNT(*) FROM (SELECT f.Tenant_ID, f.Year_Month, SUM(f.Credited_Net) AS apportioned, MAX(c.raised) AS raised FROM [Gold].[Fact_Affiliate_Payment_Lines] f JOIN (SELECT Tenant_ID, Year_Month, SUM(Amount_Pence - ISNULL(Tax_Pence,0))/100.0 AS raised FROM [Billing].[Credit_Note] GROUP BY Tenant_ID, Year_Month) c ON c.Tenant_ID = f.Tenant_ID AND c.Year_Month = f.Year_Month GROUP BY f.Tenant_ID, f.Year_Month HAVING ABS(SUM(f.Credited_Net) - MAX(c.raised)) > 0.05) x; IF @b3 > 0 BEGIN SET @m3 = 'V182 FAILED: ' + CAST(@b3 AS VARCHAR(10)) + ' practice-month(s) where apportioned credits do not sum back to the credit notes raised.'; THROW 50193, @m3, 1; END;

TEST
