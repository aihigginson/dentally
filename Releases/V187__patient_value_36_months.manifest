# =====================================================================
# Release V187 -- "Lifetime Value" was neither a lifetime nor the value
# =====================================================================
# ==> SUPERSEDED BY V188. DO NOT REPLAY THIS MANIFEST. <== The columns below were right;
# the separate table holding them was not, and V188 folded them onto
# Gold.Aggregate_Site_Patient_Current, which was already at the same grain. The files this
# manifest deploys have been deleted, so a replay fails at the first DEPLOY line. Kept only
# as the record of what was reasoned about the metric itself.
# =====================================================================
# The measure was SUM('List Patients'[Total Invoiced]), and it was wrong in two separate ways.
#
# ==> IT COUNTED NO PLAN INCOME. <== A membership patient's monthly fee is not an invoice, so
# none of it was in the figure. On the live practice:
#
#     cohort          patients   avg invoiced   avg capitation   avg TOTAL
#     plan patient       1,416            737            2,139       2,876
#     private            4,048          1,390               24       1,414
#     NHS                1,571            164                1         165
#
# The practice's most valuable cohort showed as worth HALF a private patient, with 74% of
# their value invisible. For a number whose entire job is "who would I mind losing", it ranked
# the two largest cohorts the wrong way round -- and it is the sort order of the dormant
# patient worklist, so the most valuable lapsed patients sat at the BOTTOM of the list
# somebody works down. 42 of the demo practice's 306 dormant patients are worth more in plan
# fees than in invoices.
#
# ==> AND IT WAS NEVER A LIFETIME. <== Dentally holds nothing from before a practice migrates
# onto it. The live practice's own patient_stats total is SMALLER than what the warehouse has
# loaded since go-live, so there is no longer history being truncated -- it does not exist
# anywhere. "Lifetime" therefore meant 5.7 years for one customer and six months for the next,
# and was never comparable between practices or over time.
#
# A ROLLING 36 MONTHS is computable for every practice, means the same thing for all of them,
# and covers three recall cycles. Attendance is carried ALONGSIDE, not instead: a plan patient
# attending six-monthly hygiene is loyal and low-margin, a private patient with one 2,000
# crown a year is the reverse, and collapsing those to one number loses the distinction the
# report exists to draw.
#
# ==> THE MODEL MUST BE UPDATED TOO, AND THE NEW TABLE IS TENANT-BEARING. <==
#   1. import PBI.[Aggregate Patient Value], relate [fk Patient] -> 'List Patients'[pk Patient]
#   2. APPLY THE RLS RULE TO IT. It carries a Tenant ID, so without the filter it is a
#      cross-tenant leak. Scripts\Check_RLS_Expression.ps1 will fail the build if it is missed.
#   3. replace the measure:  Patient Value 3yr = SUM('Aggregate Patient Value'[Value Total])
#      and retire 'Lifetime Value' rather than leaving both -- two figures both called value,
#      differing by the plan half, is how this gets believed again.
#
# Run: .\Scripts\Deploy.ps1 -Manifest Releases\V187__patient_value_36_months.manifest
# =====================================================================

DEPLOY   Fabric\Gold.Aggregate_Patient_Value.Table.sql
DEPLOY   Fabric\Gold.usp_Load_Aggregate_Patient_Value.StoredProcedure.sql
DEPLOY   Fabric\Audit.Process_Config.Patient_Value.Data.sql
DEPLOY   Fabric\Gold.usp_Load_Fact_Data_Quality_Detail.StoredProcedure.sql

EXEC     DECLARE @i BIGINT,@u BIGINT,@d BIGINT; EXEC Gold.usp_Load_Aggregate_Patient_Value @Mode='PROD',@Run_Inserts=@i OUT,@Run_Updates=@u OUT,@Run_Deletes=@d OUT;
EXEC     DECLARE @i BIGINT,@u BIGINT,@d BIGINT; EXEC Gold.usp_Load_Fact_Data_Quality_Detail @Mode='PROD',@Run_Inserts=@i OUT,@Run_Updates=@u OUT,@Run_Deletes=@d OUT;
EXEC     EXEC Meta.usp_Create_Gold_Views;

# Every patient must have a value row, or they silently drop off a worklist ordered by it.
EXEC     DECLARE @m INT, @s VARCHAR(4000); SELECT @m = COUNT(*) FROM [Gold].[Dim_Patients] p WHERE p.pk_Patient > 0 AND NOT EXISTS (SELECT 1 FROM [Gold].[Aggregate_Patient_Value] v WHERE v.fk_Patient = p.pk_Patient AND v.Tenant_ID = p.Tenant_ID); IF @m > 0 BEGIN SET @s = 'V187 FAILED: ' + CAST(@m AS VARCHAR(10)) + ' patient(s) have no value row.'; THROW 50187, @s, 1; END;

# The capitation half must actually be present. If this throws, the aggregate has been
# filtered to Revenue_Type = 'Invoice' somewhere and the old bug is back, silently.
EXEC     DECLARE @c INT, @t VARCHAR(4000); SELECT @c = COUNT(*) FROM [Gold].[Aggregate_Patient_Value] WHERE Value_Capitation > 0; IF @c = 0 AND EXISTS (SELECT 1 FROM [Gold].[Fact_Revenue] WHERE Revenue_Type = 'Capitation') BEGIN SET @t = 'V187 FAILED: capitation revenue exists but no patient carries any -- the aggregate is invoiced-only again.'; THROW 50188, @t, 1; END;

TEST
