.env
*.env.txt
__pycache__/
*.pyc
*.pyo
# Local service-principal credentials for Scripts/Run_Tests.ps1 (never commit)
Scripts/fabric_creds.local.ps1

# Local Xero OAuth credentials + token cache + raw data dumps (never commit)
API/xero_creds.local.py
API/xero_token.local.json
API/xero_data/

# Local Dentally token + raw discovery dumps (never commit)
API/dentally_creds.local.py
API/dentally_data/

# Python test caches
.pytest_cache/
__pycache__/

# Throwaway debugging screenshots dropped in the repo root
Screenshot *.png
/_wt_*/

# Published docs are assembled from the canonical root copies at deploy time
# (deploy-site.yml), never committed — keeps the Trust page in sync with source.
Website/docs/

# PBIR thin-report definitions (*.pbip + *.Report/) ARE tracked -- plain-text JSON,
# small and diffable. Keep the binary .pbix out (the "PBI Dentally.pbix" model carries
# cached data > GitHub's 100MB limit; never repackage a .pbix) and the per-user .pbi
# cache/localSettings (machine-specific, not shareable).
PBI/*.pbix
PBI/**/.pbi/

# Local scratch helpers + one-off scripts (kept on disk, never committed).
# The _ prefix is the convention for personal tooling: _q.py/_qp.py (warehouse query
# helpers), _edit_engine.py (encoding-preserving SQL editor), plus throwaway one-offs.
Scripts/_*

# Runtime lock for the scheduler (machine-local state, not shareable)
.claude/scheduled_tasks.lock
