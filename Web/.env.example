# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# Entra ID (Azure AD) app registration
TENANT_ID=your-entra-tenant-id
CLIENT_ID=your-app-client-id
CLIENT_SECRET=your-client-secret

# Fabric workspace ID (from the URL when viewing the workspace in Fabric portal)
WORKSPACE_ID=your-fabric-workspace-id
DATASET_ID=your-semantic-model-dataset-id

# Fabric Warehouse SQL endpoint
FABRIC_SERVER=emeh72n2ntdufpj4q665b2lzx4-4i26eirspjiujnltrvplquzkem.datawarehouse.fabric.microsoft.com
FABRIC_DB=WH_Dentally

# AppDB Fabric SQL Database (owner-curated target Inputs). Server = same workspace host but
# .database. (not .datawarehouse.); DB name includes the item GUID. The app SP/managed identity
# needs a user grant in AppDB (see AppDB/README.md).
APPDB_SERVER=emeh72n2ntdufpj4q665b2lzx4-4i26eirspjiujnltrvplquzkem.database.fabric.microsoft.com
APPDB_DB=AppDB-4c31e989-45ca-456c-a319-1a7a262c8aa3

# Power BI report IDs (from the URL when viewing each published report)
# e.g. https://app.powerbi.com/groups/{workspace_id}/reports/{report_id}
REPORT_ID_HOME=
REPORT_ID_REVENUE=
REPORT_ID_PATIENT=
REPORT_ID_SCHEDULE=
REPORT_ID_CLINICAL=
REPORT_ID_NHS=

# Self-serve onboarding: where to email the "an onboarding is waiting to be provisioned" alert
# (onboarding is throttled/run by hand). Defaults to ONBOARDING_REPLY_TO / sales@analytically.info.
ONBOARDING_NOTIFY=
