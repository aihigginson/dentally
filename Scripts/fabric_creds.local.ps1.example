# ---------------------------------------------------------------------------
# fabric_creds.local.ps1.example
# ---------------------------------------------------------------------------
# Copy this file to  Scripts/fabric_creds.local.ps1  (which is gitignored)
# and fill in the service principal details. Run_Tests.ps1 / Deploy.ps1 dot-source
# it automatically. NEVER commit the filled-in copy.
#
# IMPORTANT (ACCESS_MODEL.md sec 4): put the **DEV** service principal here only.
# This file defaults FABRIC_SERVER to the DEV warehouse, so it can only reach dev.
# Production deploys do NOT use a local secret -- they run via the 'Deploy Warehouse'
# GitHub Action with target=prod, which authenticates the PROD SP through OIDC
# federation. Do not put the prod SP secret on a laptop.
# ---------------------------------------------------------------------------

$env:FABRIC_SP_TENANT        = '00000000-0000-0000-0000-000000000000'   # Azure AD tenant id (or <name>.onmicrosoft.com)
$env:FABRIC_SP_CLIENT_ID     = '00000000-0000-0000-0000-000000000000'   # DEV SP application (client) id
$env:FABRIC_SP_CLIENT_SECRET = 'your-dev-sp-client-secret-here'

# Optional overrides (defaults are correct for the analytically.info tenant):
# $env:FABRIC_SERVER    = 'emeh72n2ntdufpj4q665b2lzx4-4i26eirspjiujnltrvplquzkem.datawarehouse.fabric.microsoft.com'
# $env:FABRIC_DB        = 'WH_Dentally'
# $env:FABRIC_SQL_SCOPE = 'https://database.windows.net/.default'
