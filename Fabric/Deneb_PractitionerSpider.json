{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "background": "transparent",
  "padding": 10,

  "signals": [
    {"name": "width",     "update": "containerSize()[0]"},
    {"name": "height",    "update": "containerSize()[1]"},
    {"name": "cx",        "update": "width  / 2"},
    {"name": "cy",        "update": "height / 2 + 14"},
    {"name": "radius",    "update": "min(width, height) / 2 - 76"},
    {"name": "sel_count", "update": "length(data('dataset'))"},
    {"name": "show_sel",  "update": "sel_count === 1"},
    {"name": "sel_name",  "update": "show_sel ? data('dataset')[0]['Practitioner Name'] : ''"},
    {"name": "avg_col",   "value":  "#8AB5B2"},
    {"name": "sel_col",   "value":  "#1A527A"}
  ],

  "data": [
    {"name": "dataset"},

    {
      "name": "axes",
      "values": [
        {"key": "Spider Revenue vs Target", "label": "Revenue vs Target", "i": 0},
        {"key": "Spider Chair Utilisation", "label": "Chair Utilisation", "i": 1},
        {"key": "Spider Rev Per Hour",      "label": "Rev / Clinical Hr", "i": 2},
        {"key": "Spider New Patients",      "label": "New Patients",      "i": 3},
        {"key": "Spider Tx Conversion",     "label": "Tx Conversion",     "i": 4},
        {"key": "Spider DNA Score",         "label": "DNA Score",         "i": 5},
        {"key": "Spider UDA Completion",    "label": "UDA Completion",    "i": 6}
      ],
      "transform": [
        {"type": "formula", "expr": "(datum.i / 7) * 2 * PI - PI / 2", "as": "a"}
      ]
    },

    {
      "name": "avg_row",
      "source": "dataset",
      "transform": [
        {"type": "sample", "size": 1}
      ]
    },

    {
      "name": "avg_long",
      "source": "avg_row",
      "transform": [
        {
          "type": "fold",
          "fields": [
            "Spider Avg Revenue vs Target",
            "Spider Avg Chair Utilisation",
            "Spider Avg Rev Per Hour",
            "Spider Avg New Patients",
            "Spider Avg Tx Conversion",
            "Spider Avg DNA Score",
            "Spider Avg UDA Completion"
          ],
          "as": ["raw_key", "val"]
        },
        {
          "type": "formula",
          "expr": "replace(datum.raw_key, 'Spider Avg ', 'Spider ')",
          "as": "key"
        },
        {"type": "formula", "expr": "'Average'", "as": "series"}
      ]
    },

    {
      "name": "sel_long",
      "source": "dataset",
      "transform": [
        {
          "type": "fold",
          "fields": [
            "Spider Revenue vs Target",
            "Spider Chair Utilisation",
            "Spider Rev Per Hour",
            "Spider New Patients",
            "Spider Tx Conversion",
            "Spider DNA Score",
            "Spider UDA Completion"
          ],
          "as": ["key", "val"]
        },
        {
          "type": "formula",
          "expr": "datum['Practitioner Name']",
          "as": "series"
        },
        {
          "type": "filter",
          "expr": "length(data('dataset')) === 1"
        }
      ]
    },

    {
      "name": "combined",
      "source": ["avg_long", "sel_long"],
      "transform": [
        {"type": "formula", "expr": "isValid(datum.val) ? +datum.val : 0", "as": "val"},
        {
          "type": "joinaggregate",
          "groupby": ["key"],
          "ops": ["max"],
          "fields": ["val"],
          "as": ["vmax"]
        },
        {
          "type": "formula",
          "expr": "datum.vmax > 0 ? datum.val / datum.vmax : 0",
          "as": "norm"
        },
        {
          "type": "lookup",
          "from": "axes",
          "key": "key",
          "fields": ["key"],
          "values": ["i", "label", "a"]
        },
        {"type": "formula", "expr": "cx + datum.norm * radius * cos(datum.a)", "as": "px"},
        {"type": "formula", "expr": "cy + datum.norm * radius * sin(datum.a)", "as": "py"}
      ]
    },

    {
      "name": "avg_data",
      "source": "combined",
      "transform": [
        {"type": "filter", "expr": "datum.series === 'Average'"}
      ]
    },

    {
      "name": "sel_data",
      "source": "combined",
      "transform": [
        {"type": "filter", "expr": "datum.series !== 'Average'"}
      ]
    },

    {
      "name": "rings",
      "source": "axes",
      "transform": [
        {
          "type": "cross",
          "with": {"values": [{"r": 0.25}, {"r": 0.5}, {"r": 0.75}, {"r": 1.0}]},
          "as": ["ax", "rg"]
        },
        {"type": "formula", "expr": "datum.rg.r",                                  "as": "r"},
        {"type": "formula", "expr": "datum.ax.i",                                  "as": "i"},
        {"type": "formula", "expr": "cx + datum.rg.r * radius * cos(datum.ax.a)",  "as": "px"},
        {"type": "formula", "expr": "cy + datum.rg.r * radius * sin(datum.ax.a)",  "as": "py"}
      ]
    },

    {
      "name": "ring_labels",
      "source": "rings",
      "transform": [
        {"type": "filter", "expr": "datum.i === 0"}
      ]
    }
  ],

  "marks": [
    {
      "description": "axis spokes",
      "type": "rule",
      "from": {"data": "axes"},
      "encode": {
        "enter": {
          "x":  {"signal": "cx"},
          "y":  {"signal": "cy"},
          "x2": {"signal": "cx + radius * cos(datum.a)"},
          "y2": {"signal": "cy + radius * sin(datum.a)"},
          "stroke":      {"value": "#d0d5dd"},
          "strokeWidth": {"value": 0.8}
        }
      }
    },

    {
      "description": "concentric ring polygons",
      "type": "group",
      "from": {
        "facet": {"name": "rf", "data": "rings", "groupby": "r"}
      },
      "marks": [
        {
          "type": "line",
          "from": {"data": "rf"},
          "sort": {"field": "i", "order": "ascending"},
          "encode": {
            "enter": {
              "x":           {"field": "px"},
              "y":           {"field": "py"},
              "stroke":      {"value": "#d0d5dd"},
              "strokeWidth": {"value": 0.8},
              "interpolate": {"value": "linear-closed"}
            }
          }
        }
      ]
    },

    {
      "description": "average web",
      "type": "line",
      "from": {"data": "avg_data"},
      "sort": {"field": "i", "order": "ascending"},
      "encode": {
        "enter": {
          "x":             {"field": "px"},
          "y":             {"field": "py"},
          "fill":          {"signal": "avg_col"},
          "fillOpacity":   {"value": 0.18},
          "stroke":        {"signal": "avg_col"},
          "strokeWidth":   {"value": 2},
          "strokeOpacity": {"value": 0.85},
          "interpolate":   {"value": "linear-closed"}
        }
      }
    },

    {
      "description": "average dots",
      "type": "symbol",
      "from": {"data": "avg_data"},
      "encode": {
        "enter": {
          "x":    {"field": "px"},
          "y":    {"field": "py"},
          "fill": {"signal": "avg_col"},
          "size": {"value": 28}
        },
        "update": {
          "tooltip": {
            "signal": "{'Series': 'Practice Average', 'Metric': datum.label, 'Score': format(datum.norm * 100, '.0f') + '%'}"
          }
        }
      }
    },

    {
      "description": "selected practitioner web (only when sel_count === 1)",
      "type": "line",
      "from": {"data": "sel_data"},
      "sort": {"field": "i", "order": "ascending"},
      "encode": {
        "enter": {
          "x":           {"field": "px"},
          "y":           {"field": "py"},
          "fill":        {"signal": "sel_col"},
          "fillOpacity": {"value": 0.14},
          "stroke":      {"signal": "sel_col"},
          "strokeWidth": {"value": 2},
          "interpolate": {"value": "linear-closed"}
        },
        "update": {
          "strokeOpacity": {"signal": "show_sel ? 0.9 : 0"},
          "fillOpacity":   {"signal": "show_sel ? 0.14 : 0"}
        }
      }
    },

    {
      "description": "selected practitioner dots (only when sel_count === 1)",
      "type": "symbol",
      "from": {"data": "sel_data"},
      "encode": {
        "enter": {
          "fill": {"signal": "sel_col"},
          "size": {"value": 36}
        },
        "update": {
          "x":      {"field": "px"},
          "y":      {"field": "py"},
          "opacity":{"signal": "show_sel ? 1 : 0"},
          "tooltip": {
            "signal": "show_sel ? {'Series': datum.series, 'Metric': datum.label, 'Score': format(datum.norm * 100, '.0f') + '%'} : {}"
          }
        }
      }
    },

    {
      "description": "axis labels",
      "type": "text",
      "from": {"data": "axes"},
      "encode": {
        "enter": {
          "x":          {"signal": "cx + (radius + 40) * cos(datum.a)"},
          "y":          {"signal": "cy + (radius + 40) * sin(datum.a)"},
          "text":       {"field": "label"},
          "align":      {"signal": "cos(datum.a) > 0.2 ? 'left' : cos(datum.a) < -0.2 ? 'right' : 'center'"},
          "baseline":   {"signal": "sin(datum.a) > 0.2 ? 'top' : sin(datum.a) < -0.2 ? 'bottom' : 'middle'"},
          "fill":       {"value": "#344054"},
          "fontSize":   {"value": 10},
          "fontWeight": {"value": "600"},
          "font":       {"value": "Segoe UI, sans-serif"}
        }
      }
    },

    {
      "description": "ring percentage labels at top spoke",
      "type": "text",
      "from": {"data": "ring_labels"},
      "encode": {
        "enter": {
          "x":        {"field": "px", "offset": 4},
          "y":        {"field": "py", "offset": -3},
          "text":     {"signal": "format(datum.r * 100, '.0f') + '%'"},
          "fill":     {"value": "#98a2b3"},
          "fontSize": {"value": 8},
          "font":     {"value": "Segoe UI, sans-serif"}
        }
      }
    },

    {
      "description": "legend",
      "type": "group",
      "encode": {
        "enter": {
          "x": {"signal": "cx - 120"},
          "y": {"value": 4}
        }
      },
      "marks": [
        {
          "type": "symbol",
          "encode": {
            "enter": {
              "x": {"value": 0}, "y": {"value": 7},
              "fill": {"signal": "avg_col"}, "size": {"value": 60},
              "shape": {"value": "stroke"}
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "enter": {
              "x": {"value": 14}, "y": {"value": 11},
              "text": {"value": "Practice Average"},
              "fill": {"value": "#344054"}, "fontSize": {"value": 9},
              "font": {"value": "Segoe UI, sans-serif"}
            }
          }
        },
        {
          "type": "symbol",
          "encode": {
            "enter":  {"x": {"value": 130}, "y": {"value": 7}, "fill": {"signal": "sel_col"}, "size": {"value": 60}, "shape": {"value": "stroke"}},
            "update": {"opacity": {"signal": "show_sel ? 1 : 0"}}
          }
        },
        {
          "type": "text",
          "encode": {
            "enter":  {"x": {"value": 144}, "y": {"value": 11}, "fill": {"value": "#344054"}, "fontSize": {"value": 9}, "font": {"value": "Segoe UI, sans-serif"}},
            "update": {"text": {"signal": "show_sel ? sel_name : 'Select one practitioner'"}, "opacity": {"signal": "show_sel ? 1 : 0.4"}}
          }
        }
      ]
    }
  ]
}
